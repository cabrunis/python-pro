body {
    margin: 0;
    font-family: 'Arial', sans-serif;
    background: linear-gradient(135deg, #0b0b0b, #1f1f1f);
    color: #fff;
    overflow-x: hidden;
}

header {
    text-align: center;
    padding: 2rem;
    background: #111;
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
}

header h1 {
    font-size: 2.5rem;
    color: #00f0ff;
    animation: glow 2s infinite alternate;
}

@keyframes glow {
    from { text-shadow: 0 0 10px #00f0ff, 0 0 20px #00f0ff; }
    to { text-shadow: 0 0 25px #00f0ff, 0 0 40px #00f0ff; }
}

.card-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 2rem;
}

.card {
    background: #092031;
    border-radius: 20px;
    overflow: hidden;
    width: 300px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
    transform: translateY(50px);
    opacity: 0;
    animation: fadeUp 1s forwards;
    position: relative;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.card:nth-child(1) { animation-delay: 0.2s; }
.card:nth-child(2) { animation-delay: 0.4s; }
.card:nth-child(3) { animation-delay: 0.6s; }

@keyframes fadeUp {
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

.card img {
    width: 100%;
    display: block;
    transition: transform 0.5s ease;
}

.card-content {
    padding: 1rem;
    position: relative;
    z-index: 1;
}

.card h2 {
    margin: 0;
    font-size: 1.5rem;
    color: #00f0ff;
}

.card p {
    font-size: 0.9rem;
    color: #ccc;
}

.card::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(120deg, rgba(0,255,255,0.2), rgba(0,255,255,0.6), rgba(0,255,255,0.2));
    transform: skewX(-20deg);
    transition: left 0.7s;
    z-index: 2;
}

.card:hover::before {
    left: 100%;
}

.card:hover {
    transform: translateY(-20px) scale(1.05);
    box-shadow: 0 20px 40px rgba(0,255,255,0.5);
}

.card:hover img {
    transform: scale(1.1) rotate(-2deg);
}

@media(max-width: 960px) {
    .card-container {
        flex-direction: column;
        align-items: center;
    }
}
